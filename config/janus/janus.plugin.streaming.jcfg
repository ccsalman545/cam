#
# Janus Streaming plugin - camstream mountpoint.
#
# camstream-janus sends plain (unencrypted) RTP to this gateway:
#
#   Raspberry Pi                                    Host PC
#   camstream-janus   UDP      Janus gateway        browser
#   (this server) ----5004----> (this config) <==WebRTC==> (dashboard)
#                    ----5005---->             (RTCP PLI/FIR back on 5006)
#
# The ports below must match camstream's options (defaults shown):
#   --janus-rtp-port 5004   (videoport)
#   --janus-rtcp-port 5005  (videortcpport)
#
# Install:
#   sudo cp config/janus/janus.plugin.streaming.jcfg /etc/janus/
#   sudo systemctl restart janus

camstream {
	# Stream originates from an external tool speaking RTP
	type = rtp

	# Mountpoint id the browser uses in the "watch" request
	id = 1

	description = camstream H.264

	audio = false
	video = true

	# Plain UDP video RTP from camstream-janus
	videoport = 5004

	# camstream-janus sends RTCP Sender Reports here. Besides being
	# proper sender behavior, it makes Janus learn the source
	# address, which it needs to send PLI/FIR back to camstream when
	# a viewer cannot decode and needs a keyframe.
	videortcpport = 5005

	# Must match the payload type camstream uses (default 96;
	# see the "pt" line in camstream's startup banner).
	videopt = 96
	videortpmap = H264/90000

	# packetization-mode=1 (FU-A) matches camstream's RFC 6184
	# packetizer. profile-level-id is intentionally omitted so the
	# offer stays valid for any encoder level; the browser reads the
	# real level from the SPS in the stream. For a tighter match you
	# may pin it, e.g. for 720p30:
	#   videofmtp = profile-level-id=42001e;packetization-mode=1
	videofmtp = packetization-mode=1

	# Experimental: keep the latest keyframe + following deltas so a
	# new viewer can start immediately instead of waiting for the
	# next IDR (camstream's --keyframe interval).
	# bufferkf_ms = 5000
}
